# clang-tidy for the C++ SDK, including generated code.
# Run with `pixi run -e cpp lint-cpp-files`, which supplies the compilation database.
#
# This is a *security* lint, not a style pass — `readability-*`, `modernize-*` and
# `performance-*` would bury it. `.clang-format` remains the authority on style.
#
# ⚠️ Keys and checks must exist in clang-tidy 19, the version `clang-tools` pins. An unknown
# key makes clang-tidy discard this whole file and fall back to defaults that find almost
# nothing — a clean-looking run that checked nothing. `scripts/lint_cpp.py` guards against it.
#
# Why each check is off:
#   bugprone-easily-swappable-parameters    Style opinion, and a loud one.
#   bugprone-exception-escape               `Error` holds a `std::string`, so its constructors
#                                           can throw. Means `terminate`, not memory unsafety.
#   bugprone-forward-declaration-namespace  Declaration placement. No runtime consequence.
#   bugprone-reserved-identifier            `_CategoryFoo` enum members in the public `Error`
#   (+ cert-dcl37-c, cert-dcl51-cpp)        header. Renaming them would break the API.
#   cert-dcl50-cpp                          C-style variadics, deliberate for C interop.
#   cert-err33-c                            Unchecked `fprintf` to stderr. Nothing follows.
#   cert-err58-cpp                          Public SDK constants use generated constructors that
#                                           are not `noexcept`; changing them to accessors would
#                                           break the API.
#   cert-int09-c                            False positive e.g. for `enum class ErrorCode`.
#   bugprone-chained-comparison             Spams with expanded CHECK macros.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-forward-declaration-namespace,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl50-cpp,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -cert-err58-cpp,
  -cert-int09-c,
  -bugprone-chained-comparison

# The SDK is header-heavy, so restricting diagnostics to main files would miss most of the code.
HeaderFilterRegex: 'rerun_cpp/src/rerun/.*'

# The gate is `scripts/lint_cpp.py`, which fails on any finding. Setting this too would only
# break editors and clangd.
WarningsAsErrors: ''
