{
  "name": "@rerun-io/web-viewer",
  "version": "0.41.0",
  "description": "Embed the Rerun web viewer in your app",
  "licenses": [
    {
      "type": "MIT"
    },
    {
      "type": "Apache-2.0"
    }
  ],
  "scripts": {
    "build:wasm": "node build-wasm.mjs --mode release",
    "build:js": "tsc --emitDeclarationOnly && esbuild index.ts --bundle --format=esm --platform=browser --target=esnext --external:./re_viewer.js --legal-comments=inline --keep-names --sourcemap --outfile=index.js",
    "build": "npm run build:wasm && npm run build:js",
    "build:wasm:debug": "node build-wasm.mjs --mode debug",
    "build:debug": "npm run build:wasm:debug && npm run build:js",
    "pack": "npm pack && mv rerun-io-web-viewer-*.tgz web-viewer.tar.gz",
    "docs": "typedoc",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rerun-io/rerun.git"
  },
  "author": "rerun-io",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rerun-io/rerun/issues"
  },
  "homepage": "https://rerun.io",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./re_viewer.js": {
      "types": "./re_viewer.d.ts",
      "import": "./re_viewer.js"
    },
    "./inlined.js": {
      "types": "./inlined.d.ts",
      "import": "./inlined.js"
    }
  },
  "files": [
    "exact_json.d.ts",
    "exact_json.d.ts.map",
    "exact_json.ts",
    "index.d.ts",
    "index.d.ts.map",
    "index.js",
    "index.js.map",
    "index.ts",
    "package.json",
    "proto/**/*.d.ts",
    "re_viewer_bg.wasm",
    "re_viewer_bg.wasm.d.ts",
    "re_viewer.d.ts",
    "re_viewer.js",
    "store_id.d.ts",
    "store_id.d.ts.map",
    "store_id.ts",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "dts-buddy": "^0.8.3",
    "esbuild": "^0.25.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.3.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  }
}