## screenshot

{
  "name": "screenshot",
  "title": "Screenshot",
  "description": "Capture the current frame as a PNG screenshot.\nDefaults to logical-point resolution (`pixels_per_point: 1.0`) so pixels align with `click`/`widget_tree` coordinates; pass a higher `pixels_per_point` for detail, or `save_path` to also write it to disk.\nRequires the app window to be visible — a fully-occluded or minimized window can't render a frame to capture (notably on macOS), so the call times out; bring the window to the foreground first.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "pixels_per_point": {
        "description": "Output resolution in pixels per logical point.\nDefaults to `1.0`, which makes screenshot pixels line up 1:1 with the logical coordinates used by `click`/`widget_tree`.\nHigher values give a sharper image, capped at the display's native scale (no upscaling).",
        "type": "number",
        "format": "float",
        "default": 1.0
      },
      "save_path": {
        "description": "If set, also write the PNG to this path on the machine running the MCP server (in addition to returning it inline).",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

## scroll

{
  "name": "scroll",
  "title": "Scroll",
  "description": "Send a mouse wheel scroll over a widget (or raw `pos`).\n`delta` is in logical points: positive Y scrolls down (reveals content below); positive X scrolls right.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Id": {
        "description": "Widget id as `widget_tree` reports it: lower-case hex, no prefix.",
        "type": "string",
        "pattern": "^[0-9a-fA-F]{1,16}$"
      },
      "Pos2Lit": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "PressKeyModifiers": {
        "type": "object",
        "properties": {
          "ctrl": {
            "type": "boolean",
            "default": false
          },
          "shift": {
            "type": "boolean",
            "default": false
          },
          "alt": {
            "type": "boolean",
            "default": false
          },
          "mac_cmd": {
            "type": "boolean",
            "default": false
          },
          "command": {
            "description": "= Cmd on Mac / Ctrl on Win+Linux.",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "required": [
      "delta"
    ],
    "type": "object",
    "properties": {
      "id": {
        "description": "Widget id from `widget_tree`.",
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "content_contains": {
        "description": "Case-insensitive substring match against *either* `label` or `value`. Prefer this when you\njust want \"the widget showing this text\" and don't care which field holds it — it's the\nmost robust choice across widget kinds.",
        "type": [
          "string",
          "null"
        ]
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).\nAn unrecognized role is rejected with an error that lists the roles present in the tree.",
        "type": [
          "string",
          "null"
        ]
      },
      "label_contains": {
        "description": "Case-insensitive substring match against the widget's `label` (its accessible name) only.\nNote that `Label`/monospace widgets carry their text in `value`, not `label` — for those,\nuse `content_contains` (or `value_contains`).",
        "type": [
          "string",
          "null"
        ]
      },
      "value_contains": {
        "description": "Case-insensitive substring match against the widget's `value` only (e.g. a text field's\ncontents, or a `Label`'s text).",
        "type": [
          "string",
          "null"
        ]
      },
      "pos": {
        "description": "Raw position in logical points (use instead of locator fields).",
        "anyOf": [
          {
            "$ref": "#/$defs/Pos2Lit"
          },
          {
            "type": "null"
          }
        ]
      },
      "delta": {
        "description": "Logical points.\nPositive Y scrolls down (reveals content below); positive X scrolls right.",
        "$ref": "#/$defs/Pos2Lit"
      },
      "modifiers": {
        "$ref": "#/$defs/PressKeyModifiers"
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

