## rerun_close_recordings

{
  "name": "rerun_close_recordings",
  "description": "Close recordings in the viewer, to clear away what is no longer needed.\n\nThis only removes them from the viewer. Files on disk are untouched, and registered\nrecordings stay in the catalog and can be reopened, but unsaved blueprint edits are lost.\n\nIterating on a file you keep regenerating leaves a pile of stale recordings behind, which\nmakes the viewer state and the UI hard to read.\n\n`NOT_FOUND` if the requested recording is not open.\n\nRequires `rerun_connect`.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "current": {
        "type": "boolean",
        "enum": [
          true
        ],
        "description": "Close the active recording. Must be `true`: this is a selector, not a flag."
      },
      "all": {
        "type": "boolean",
        "enum": [
          true
        ],
        "description": "Close every open recording. Must be `true`: this is a selector, not a flag."
      },
      "store_ids": {
        "type": "object",
        "properties": {
          "store_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The recording ids to close, each as `{kind}:{application_id}:{recording_id}`."
          }
        },
        "description": "Close these recordings."
      }
    },
    "oneOf": [
      {
        "required": [
          "current"
        ]
      },
      {
        "required": [
          "all"
        ]
      },
      {
        "required": [
          "store_ids"
        ]
      }
    ],
    "description": "Request for `CloseRecordings`.\n\nExactly one of `current`, `all`, `store_ids` must be set."
  }
}

## rerun_connect

{
  "name": "rerun_connect",
  "description": "Connect to a running Rerun viewer over gRPC.\nThe other tools will be available once the connection is established.\n`endpoint` defaults to the viewer this server was started for, else `http://127.0.0.1:9876`\n(the viewer's default gRPC address).\nConnecting again to the same endpoint is a no-op. Connecting to a different endpoint\nreplaces the old connection once the new connection succeeds. Call `rerun_disconnect` to drop\nthe connection without replacing it.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "endpoint": {
        "description": "gRPC endpoint of the running viewer's `ViewerControlService`.\nDefaults to the endpoint the server was started for, else `http://127.0.0.1:9876`.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "type": "object"
  }
}

## rerun_disconnect

{
  "name": "rerun_disconnect",
  "description": "Disconnect from the viewer, dropping the gRPC-backed bridge.\nThe tools stop working until `rerun_connect` is called again.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object"
  }
}

## rerun_get_recording_schema

{
  "name": "rerun_get_recording_schema",
  "description": "Report a recording's schema: its timelines, every entity, every component ever logged on\nit, whether that component has a static value, and its Arrow datatype.\n\n`paths_only` answers the cheaper question — which entities exist at all — for a recording\ntoo large to describe in full.\n\nRead this before naming an entity path or a component anywhere else. A component name\nguessed from an archetype's documentation is often not the one the recording carries, and\nthe viewer cannot tell a caller that it guessed wrong — a query for a component that is not\nthere just comes back empty.\n\nThis is the schema, not the data: a component listed here has been logged at some point,\nwhich says nothing about the current time cursor. Read values through the catalog server\n`GetViewerState` reports as `catalog_url`.\n\n`NOT_FOUND` if the requested recording is not open.\n\nRequires `rerun_connect`.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "store_id": {
        "type": "string",
        "description": "Recording to describe, as `{kind}:{application_id}:{recording_id}`. If omitted, the active\nrecording is used."
      },
      "entity_path": {
        "type": "string",
        "description": "Only describe this entity and the entities below it, e.g. `/world/robot`. Omit for the whole\nrecording.\n\nA recording with more entities than one answer holds comes back truncated, and narrowing here\nis how to read the rest of it.\n\n`NOT_FOUND` if nothing in the recording is at or below this path, since an empty answer would\notherwise read as \"the recording has no such data\" rather than \"that path is not in it\"."
      },
      "max_entities": {
        "type": "integer",
        "minimum": 0,
        "description": "How many entities to describe at most.\n\nDefaults to 100, or to 10000 with `paths_only`, since a path costs a line where the\ncomponents on it cost many."
      },
      "paths_only": {
        "type": "boolean",
        "description": "Name the entities without describing what is logged on them.\n\nA whole recording's paths fit in one answer at a size worth reading, where its components\nwould not. Use this to see the shape of an unfamiliar recording, then call again with\n`entity_path` for the components of the entities that turned out to matter."
      }
    },
    "description": "Request for `GetRecordingSchema`."
  }
}

## rerun_get_viewer_logs

{
  "name": "rerun_get_viewer_logs",
  "description": "Return the viewer's recent log messages (INFO and above), oldest first, so a caller sees the\nwarnings and errors the user sees. A warning here usually explains what the user is seeing.\n\nEntries carry a sequence number, so passing the last one back fetches only what is new.\n\nRequires `rerun_connect`.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "after_sequence": {
        "type": "integer",
        "minimum": 0,
        "description": "Only return entries with a sequence number greater than this.\nOmit for everything still buffered."
      }
    },
    "description": "Request for `GetViewerLogs`."
  }
}

## rerun_get_viewer_state

{
  "name": "rerun_get_viewer_state",
  "description": "Report what the viewer is currently showing, so a caller can orient itself.\n\nCovers the active recording, the current page URL, every open recording with its timelines,\ntheir time ranges and its current time cursor, and every view of the current blueprint with\nthe warnings and errors that view reports.\n\nCall this to learn which recording and timeline to drive, and which time values are valid,\nbefore moving the time cursor. A view's reports say what failed to visualize.\n\nRecordings are named by a store id string, `{kind}:{application_id}:{recording_id}`, e.g.\n`Recording:my_app:1830B33B45B963E7`. Pass it back whole wherever an operation takes a\nrecording. To read a part out of one: the kind runs to the first colon, the application id\nto the next colon that is not preceded by a backslash, and the recording id is the rest.\nBoth ids may contain a colon, so the application id's are escaped as `\\:` (and `\\` as `\\\\`).\n\nRequires `rerun_connect`.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "description": "Request for `GetViewerState`. Empty: the whole state is always returned."
  }
}

## rerun_open_url

{
  "name": "rerun_open_url",
  "description": "Open a URL in the viewer (a recording/blueprint file, a `rerun://` dataset URI, a redap\nserver/catalog URL, or an intra-recording link).\n\nReturns as soon as the load *starts*. Poll `GetViewerState` until its `loading` list is\nempty; only then does an absent timeline mean an empty recording rather than one still\narriving. Do not drive the UI while it loads — a viewer busy importing paints no frames,\nso anything waiting on one stalls, while `GetViewerState` keeps answering.\n\nRequires `rerun_connect`.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "The URL to open in the viewer. This can be a recording/blueprint file URL, a `rerun://`\ndataset URI, a redap server/catalog URL, or an intra-recording link."
      }
    },
    "required": [
      "url"
    ],
    "description": "Request for `OpenUrl`."
  }
}

## rerun_save_screenshot

{
  "name": "rerun_save_screenshot",
  "description": "Take a screenshot of the viewer, or of a single view within it, and write it to disk.\n\nThe screenshot is saved by the viewer process, so the path is resolved on the machine\nrunning the viewer, not on the machine making the request.\n\nFails with `INVALID_ARGUMENT` if `view_id` is not a UUID, `NOT_FOUND` if no such view is\ncurrently visible, `FAILED_PRECONDITION` if the view is too small to capture, and\n`INTERNAL` if the capture itself or the write to disk failed.\n\nRequires `rerun_connect`.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "view_id": {
        "type": "string",
        "description": "Optional view ID to screenshot. If omitted, screenshots the entire viewer."
      },
      "file_path": {
        "type": "string",
        "description": "Path at which the screenshot will be saved.\nThis path is relative to the current working directory of the viewer process."
      }
    },
    "required": [
      "file_path"
    ],
    "description": "Request for `SaveScreenshot`."
  }
}

## rerun_set_time_cursor

{
  "name": "rerun_set_time_cursor",
  "description": "Move the time cursor (timeline position) of a recording in the viewer.\n\nRequires `rerun_connect`.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "store_id": {
        "type": "string",
        "description": "Recording to seek, as `{kind}:{application_id}:{recording_id}`. If omitted, the active\nrecording is used."
      },
      "timeline": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the timeline, e.g. `log_time`."
          }
        },
        "required": [
          "name"
        ],
        "description": "Timeline to seek on. If omitted, the active timeline is used."
      },
      "time": {
        "type": "object",
        "properties": {
          "time": {
            "type": "integer",
            "description": "The time value. Its meaning depends on the timeline's `TimeType`."
          }
        },
        "required": [
          "time"
        ],
        "description": "Time value to seek to: a sequence index for sequence timelines, or nanoseconds for\ntemporal timelines (see `GetViewerState` for each timeline's type and range)."
      },
      "play": {
        "type": "boolean",
        "description": "If true, start playing the recording from the new position. Omit it, or pass false, to\npause the recording instead."
      }
    },
    "required": [
      "time"
    ],
    "description": "Request for `SetTimeCursor`."
  }
}

## resize

{
  "name": "resize",
  "description": "Resize the app's viewport to the given logical-point dimensions.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "width",
      "height"
    ],
    "type": "object",
    "properties": {
      "width": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "height": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    }
  }
}

## screenshot

{
  "name": "screenshot",
  "description": "Capture the current frame as a PNG screenshot.\nDefaults to logical-point resolution (`pixels_per_point: 1.0`) so pixels align with `click`/`query_tree` coordinates; pass a higher `pixels_per_point` for detail, or `save_path` to also write it to disk.\nRequires the app window to be visible — a fully-occluded or minimized window can't render a frame to capture (notably on macOS), so the call times out; bring the window to the foreground first.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "pixels_per_point": {
        "description": "Output resolution in pixels per logical point.\nDefaults to `1.0`, which makes screenshot pixels line up 1:1 with the logical coordinates used by `click`/`query_tree`.\nHigher values give a sharper image, capped at the display's native scale (no upscaling).",
        "type": "number",
        "format": "float",
        "default": 1.0
      },
      "save_path": {
        "description": "If set, also write the PNG to this path on the machine running the MCP server (in addition to returning it inline).",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "type": "object"
  }
}

## scroll

{
  "name": "scroll",
  "description": "Send a mouse wheel scroll over a node (or raw `pos`).\n`delta` is in logical points: positive Y scrolls down (reveals content below); positive X scrolls right.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Pos2Lit": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "PressKeyModifiers": {
        "type": "object",
        "properties": {
          "ctrl": {
            "type": "boolean",
            "default": false
          },
          "shift": {
            "type": "boolean",
            "default": false
          },
          "alt": {
            "type": "boolean",
            "default": false
          },
          "mac_cmd": {
            "type": "boolean",
            "default": false
          },
          "command": {
            "description": "= Cmd on Mac / Ctrl on Win+Linux.",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "required": [
      "delta"
    ],
    "type": "object",
    "properties": {
      "id": {
        "description": "Node id from `query_tree`.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "content_contains": {
        "description": "Case-insensitive substring match against *either* `label` or `value`. Prefer this when you\njust want \"the widget showing this text\" and don't care which field holds it — it's the\nmost robust choice across widget kinds.",
        "type": [
          "string",
          "null"
        ]
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).\nAn unrecognized role is rejected with an error that lists the roles present in the tree.",
        "type": [
          "string",
          "null"
        ]
      },
      "label_contains": {
        "description": "Case-insensitive substring match against the node's `label` (its accessible name) only.\nNote that `Label`/monospace widgets carry their text in `value`, not `label` — for those,\nuse `content_contains` (or `value_contains`).",
        "type": [
          "string",
          "null"
        ]
      },
      "value_contains": {
        "description": "Case-insensitive substring match against the node's `value` only (e.g. a text field's\ncontents, or a `Label`'s text).",
        "type": [
          "string",
          "null"
        ]
      },
      "pos": {
        "description": "Raw position in logical points (use instead of locator fields).",
        "anyOf": [
          {
            "$ref": "#/$defs/Pos2Lit"
          },
          {
            "type": "null"
          }
        ]
      },
      "delta": {
        "description": "Logical points.\nPositive Y scrolls down (reveals content below); positive X scrolls right.",
        "$ref": "#/$defs/Pos2Lit"
      },
      "modifiers": {
        "$ref": "#/$defs/PressKeyModifiers"
      }
    }
  }
}

## type_text

{
  "name": "type_text",
  "description": "Type text into the currently focused widget.\nOptionally focus a node first (by `id`, `role`, or a text match — `content_contains`/`label_contains`/`value_contains`) — this uses an `AccessKit` focus request, not a click, so it won't move the cursor or clear an existing text selection.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string"
      },
      "id": {
        "description": "Optional focus target: node id from `query_tree` to focus before typing.\nOmit all locator fields to type into whatever is currently focused.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "content_contains": {
        "description": "Case-insensitive substring match against *either* `label` or `value`. Prefer this when you\njust want \"the widget showing this text\" and don't care which field holds it — it's the\nmost robust choice across widget kinds.",
        "type": [
          "string",
          "null"
        ]
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).\nAn unrecognized role is rejected with an error that lists the roles present in the tree.",
        "type": [
          "string",
          "null"
        ]
      },
      "label_contains": {
        "description": "Case-insensitive substring match against the node's `label` (its accessible name) only.\nNote that `Label`/monospace widgets carry their text in `value`, not `label` — for those,\nuse `content_contains` (or `value_contains`).",
        "type": [
          "string",
          "null"
        ]
      },
      "value_contains": {
        "description": "Case-insensitive substring match against the node's `value` only (e.g. a text field's\ncontents, or a `Label`'s text).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  }
}

## wait_for

{
  "name": "wait_for",
  "description": "Poll the widget tree until its conditions hold, or until `timeout_secs` elapses.\nWaits until at least `min_matches` visible nodes match the filter (when one is given) *and* at least `min_steps` frames have rendered since the call began.\nThe text filter is `role` and/or one of `content_contains` (matches `label` or `value` — prefer this; e.g. monospace/`Label` text lives in `value`), `label_contains`, `value_contains`.\nRequires a filter (`content_contains`/`role`/`label_contains`/`value_contains`) or a non-zero `min_steps`.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "content_contains": {
        "description": "Case-insensitive substring match against *either* `label` or `value`. Prefer this when you\njust want \"the widget showing this text\" and don't care which field holds it — it's the\nmost robust choice across widget kinds.",
        "type": [
          "string",
          "null"
        ]
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).\nAn unrecognized role is rejected with an error that lists the roles present in the tree.",
        "type": [
          "string",
          "null"
        ]
      },
      "label_contains": {
        "description": "Case-insensitive substring match against the node's `label` (its accessible name) only.\nNote that `Label`/monospace widgets carry their text in `value`, not `label` — for those,\nuse `content_contains` (or `value_contains`).",
        "type": [
          "string",
          "null"
        ]
      },
      "value_contains": {
        "description": "Case-insensitive substring match against the node's `value` only (e.g. a text field's\ncontents, or a `Label`'s text).",
        "type": [
          "string",
          "null"
        ]
      },
      "timeout_secs": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0,
        "default": 5
      },
      "min_matches": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "default": 1
      },
      "min_steps": {
        "description": "Also wait until at least this many frames have rendered since the call began.\nUse it to let animations, tooltips, or other time/frame-driven UI settle (e.g. after a `hover`); `0` means don't wait for frames.",
        "type": "integer",
        "format": "uint64",
        "minimum": 0,
        "default": 0
      }
    },
    "type": "object"
  }
}
